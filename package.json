{
  "name": "kn-builders",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender && npm run sitemap && npm run robots && npm run llms",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir .ssr-dist",
    "prerender": "node --import ./scripts/register-loader.mjs scripts/prerender.mjs",
    "preview": "vite preview",
    "sitemap": "node --import ./scripts/register-loader.mjs scripts/sitemap.mjs",
    "robots": "node scripts/robots.mjs",
    "llms": "node --import ./scripts/register-loader.mjs scripts/llms.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
